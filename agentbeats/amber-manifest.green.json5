{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "mutation": {
        "type": "string",
        "enum": ["none", "details_array"],
        "default": "none"
      }
    },
    "additionalProperties": false
  },
  "slots": {
    "subject": {"kind": "a2a"}
  },
  "program": {
    "image": "evalreliability-agentbeats-green:local",
    "entrypoint": "/app/agentbeats/.venv/bin/python -m agentbeats_adapter.server --role green --host 0.0.0.0 --port 9009",
    "env": {
      "AMBER_HINT_SUBJECT": "${slots.subject}"
    },
    "network": {
      "endpoints": [
        {"name": "a2a_endpoint", "port": 9009}
      ]
    }
  },
  "provides": {
    "a2a": {"kind": "a2a", "endpoint": "a2a_endpoint"}
  },
  "exports": {"a2a": "a2a"},
  "metadata": {
    "assessment_config": {"mutation": "none"},
    "participant_roles": ["subject"]
  }
}
