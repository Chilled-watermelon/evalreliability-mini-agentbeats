FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca

RUN adduser --disabled-password --gecos "" agent
WORKDIR /app
COPY agentbeats/pyproject.toml agentbeats/uv.lock /app/agentbeats/
RUN uv sync --locked --no-dev --project /app/agentbeats
COPY evalreliability /app/evalreliability
COPY agentbeats_adapter /app/agentbeats_adapter
USER agent
ENV PYTHONPATH=/app
ENTRYPOINT ["/app/agentbeats/.venv/bin/python", "-m", "agentbeats_adapter.server", "--role", "green"]
CMD ["--host", "0.0.0.0", "--port", "9009"]
EXPOSE 9009
